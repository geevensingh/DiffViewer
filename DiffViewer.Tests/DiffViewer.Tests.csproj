<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>DiffViewer.Tests</RootNamespace>
    <AssemblyName>DiffViewer.Tests</AssemblyName>
    <UseWPF>true</UseWPF>
    <!-- Match DiffViewer.csproj's Release RID so the referenced
         DiffViewer.dll (AMD64) matches the test assembly's
         architecture. Avoids MSB3270 in Release builds. The app is
         Windows-x64-only, so the tests inherently are too. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="FluentAssertions" Version="6.12.1" />
    <PackageReference Include="Xunit.StaFact" Version="1.1.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiffViewer\DiffViewer.csproj" />
  </ItemGroup>

  <!-- Copy MainWindow.xaml into the test output so
       KeyboardShortcutsDriftTests can parse it at runtime and assert
       a bijection with KeyboardShortcutCatalog. Link rename keeps it
       away from any *.xaml glob (the SDK's WPF <Page> include is
       project-dir-relative and won't match an upward-path include
       anyway, but the rename is belt-and-braces). -->
  <ItemGroup>
    <None Include="..\DiffViewer\MainWindow.xaml" Link="TestData\MainWindow.xaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
