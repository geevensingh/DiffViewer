<Window x:Class="DiffViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DiffViewer.ViewModels"
        xmlns:views="clr-namespace:DiffViewer.Views"
        xmlns:utility="clr-namespace:DiffViewer.Utility"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        mc:Ignorable="d"
        Title="{Binding WindowTitle, FallbackValue=DiffViewer}"
        Icon="/Assets/diffviewer.ico"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.InputBindings>
        <!-- Settings -->
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding ShowSettingsCommand}"/>

        <!-- Help / cheat sheet -->
        <KeyBinding Key="F1" Command="{Binding ShowKeyboardShortcutsCommand}"/>

        <!-- Refresh -->
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>

        <!-- Hunk navigation: F8 next change, F7 previous change.
             Cross-file + cross-section flow with cycling. Alt+Down /
             Alt+Up are screen-reader-friendly aliases (NVDA claims F7,
             JAWS occasionally F8). -->
        <KeyBinding Key="F8"   Command="{Binding NavigateNextChangeCommand}"/>
        <KeyBinding Key="F7"   Command="{Binding NavigatePreviousChangeCommand}"/>
        <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding NavigateNextChangeCommand}"/>
        <KeyBinding Key="Up"   Modifiers="Alt" Command="{Binding NavigatePreviousChangeCommand}"/>

        <!-- File-step (skip per-hunk) -->
        <KeyBinding Key="F8" Modifiers="Shift" Command="{Binding NavigateNextFileCommand}"/>
        <KeyBinding Key="F7" Modifiers="Shift" Command="{Binding NavigatePreviousFileCommand}"/>

        <!-- Section-step -->
        <KeyBinding Key="F8" Modifiers="Control" Command="{Binding NavigateNextSectionCommand}"/>
        <KeyBinding Key="F7" Modifiers="Control" Command="{Binding NavigatePreviousSectionCommand}"/>

        <!-- Toolbar toggles -->
        <KeyBinding Key="W" Modifiers="Control"        Command="{Binding ToggleIgnoreWhitespaceCommand}"/>
        <KeyBinding Key="W" Modifiers="Control+Shift"  Command="{Binding ToggleVisibleWhitespaceCommand}"/>
        <KeyBinding Key="I" Modifiers="Control"        Command="{Binding ToggleSideBySideCommand}"/>
        <KeyBinding Key="D" Modifiers="Control"        Command="{Binding ToggleIntraLineDiffCommand}"/>
        <KeyBinding Key="L" Modifiers="Control"        Command="{Binding ToggleLiveUpdatesCommand}"/>
        <KeyBinding Key="L" Modifiers="Control+Shift"  Command="{Binding ToggleWordWrapCommand}"/>

        <!-- Display modes -->
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding SetDisplayModeFullPathCommand}"/>
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding SetDisplayModeRepoRelativeCommand}"/>
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding SetDisplayModeGroupedCommand}"/>

        <!-- File-list filter (issue #3): Ctrl+/ focuses the filter box. -->
        <KeyBinding Key="OemQuestion" Modifiers="Control" Command="{Binding FocusFilterCommand}"/>

        <!-- Focus cycle -->
        <KeyBinding Key="F6" Command="{Binding CycleFocusCommand}"/>

        <!-- Zoom (forwarded to DiffPane). Ctrl+= covers ANSI '+' (unshifted),
             Ctrl+OemPlus covers shifted layouts where OEM gives the actual
             '+' keycode, Ctrl+Add covers the numeric keypad. Same triple
             for zoom-out. -->
        <KeyBinding Key="OemPlus"  Modifiers="Control" Command="{Binding DiffPane.ZoomInCommand}"/>
        <KeyBinding Key="Add"      Modifiers="Control" Command="{Binding DiffPane.ZoomInCommand}"/>
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding DiffPane.ZoomOutCommand}"/>
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding DiffPane.ZoomOutCommand}"/>
        <KeyBinding Key="D0"       Modifiers="Control" Command="{Binding DiffPane.ZoomResetCommand}"/>
        <KeyBinding Key="NumPad0"  Modifiers="Control" Command="{Binding DiffPane.ZoomResetCommand}"/>
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <!-- Auto-update banner (Phase 2.3). Stays Collapsed until
                 UpdateNotificationViewModel.IsBannerVisible flips. -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.Resources>
            <DataTemplate DataType="{x:Type vm:MainViewModel}">
                <Grid Loaded="OnMainLayoutGridLoaded">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="FileListColumn"
                                          MinWidth="{x:Static utility:FileListLayout.MinFileListPaneWidthPixels}"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*" MinWidth="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- Column 0: recents dropdown, commit-metadata
                         header rows (one per commit side), and the file
                         list. The commit rows collapse to nothing for
                         working-tree sides via the null-DataContext
                         DataTrigger on each. -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <views:RecentsBarView Grid.Row="0"
                                              DataContext="{Binding Recents}"/>
                        <views:CommitMetadataHeaderRow Grid.Row="1"
                                                       DataContext="{Binding LeftCommitPanel}">
                            <views:CommitMetadataHeaderRow.Style>
                                <Style TargetType="views:CommitMetadataHeaderRow">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:CommitMetadataHeaderRow.Style>
                        </views:CommitMetadataHeaderRow>
                        <views:CommitMetadataHeaderRow Grid.Row="2"
                                                       DataContext="{Binding RightCommitPanel}">
                            <views:CommitMetadataHeaderRow.Style>
                                <Style TargetType="views:CommitMetadataHeaderRow">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:CommitMetadataHeaderRow.Style>
                        </views:CommitMetadataHeaderRow>
                        <views:FileListView Grid.Row="3"
                                            DataContext="{Binding FileList}"/>
                    </Grid>

                    <GridSplitter Grid.Column="1"
                                  Width="5"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="#DDDDDD"
                                  DragCompleted="OnFileListSplitterDragCompleted"/>

                    <Border Grid.Column="2"
                            Background="White">
                        <views:DiffPaneView DataContext="{Binding DiffPane}"/>
                    </Border>
                </Grid>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:EmptyContextViewModel}">
                <DockPanel LastChildFill="True">
                    <!-- Recents dropdown at top so the user can pick a context. -->
                    <views:RecentsBarView DockPanel.Dock="Top"
                                          DataContext="{Binding Recents}"/>
                    <Border Background="White">
                        <TextBlock Text="{Binding Message}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="600"
                                   Foreground="#666666"
                                   Padding="20"/>
                    </Border>
                </DockPanel>
            </DataTemplate>
        </Grid.Resources>

        <!-- Auto-update banner. Data context wired in App.OnStartup via
             MainWindow.AttachUpdateNotification; collapsed until the
             view-model fires IsBannerVisible. The Install button is
             shown only in NotifyOnly mode before the user accepts the
             update. -->
        <Border x:Name="UpdateBanner"
                Grid.Row="0"
                Background="#FFF8E1"
                BorderBrush="#E0C97A"
                BorderThickness="0,0,0,1"
                Padding="12,6"
                Visibility="{Binding IsBannerVisible,
                                     Converter={x:Static vm:BoolToVisibilityConverter.Instance},
                                     FallbackValue=Collapsed}">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Dismiss"
                        Padding="10,2"
                        Margin="6,0,0,0"
                        Command="{Binding DismissCommand}"/>
                <Button DockPanel.Dock="Right"
                        Content="Install"
                        Padding="10,2"
                        Command="{Binding InstallCommand}"
                        Visibility="{Binding ShowInstallButton,
                                             Converter={x:Static vm:BoolToVisibilityConverter.Instance},
                                             FallbackValue=Collapsed}"/>
                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           Foreground="#4A3B0A"/>
            </DockPanel>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding}"/>

        <!-- Window-level loading overlay. Visible whenever the coordinator
             is in the middle of a context switch (PR fetch, git fetch,
             repo build). Sits above the ContentControl in Z-order so it
             veils the stale outgoing content while the new context is
             prepared. The coordinator lives on Window.Tag (set in
             App.xaml.cs); RelativeSource binding reaches it without
             touching the existing DataContext = Coordinator.Current
             plumbing. Spans both banner and content rows so it veils
             the banner too while a switch is in flight. -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Background="#80FFFFFF"
              Visibility="{Binding Tag.IsSwitching, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
            <Border Background="White"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="24,20"
                    MinWidth="340"
                    MaxWidth="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12"
                                      Direction="270"
                                      ShadowDepth="2"
                                      Opacity="0.25"
                                      Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Loading&#x2026;"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#222222"
                               Margin="0,0,0,10"/>
                    <ProgressBar IsIndeterminate="True"
                                 Height="6"
                                 Margin="0,0,0,12"
                                 Background="#F0F0F0"
                                 BorderThickness="0"/>
                    <TextBlock Text="{Binding Tag.SwitchingStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="#555555"
                               FontFamily="Segoe UI"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

