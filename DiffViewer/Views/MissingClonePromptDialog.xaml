<Window x:Class="DiffViewer.Views.MissingClonePromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DiffViewer.ViewModels"
        Title="{Binding Title}"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Description}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Foreground="DimGray"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />

        <TextBlock Grid.Row="2"
                   Text="{Binding ErrorMessage}"
                   Foreground="DarkRed"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <StackPanel Grid.Row="3"
                    Orientation="Vertical"
                    Margin="0,0,0,8"
                    Visibility="{Binding CloneInProgress,
                                  Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
            <TextBlock Text="{Binding ProgressLabel}" Margin="0,0,0,4" />
            <ProgressBar Height="14"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding ProgressPercent, Mode=OneWay}" />
            <Button Content="Cancel clone"
                    Command="{Binding CancelCloneCommand}"
                    HorizontalAlignment="Left"
                    Margin="0,6,0,0"
                    Padding="12,4" />
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Browse to existing clone…"
                    Command="{Binding BrowseExistingCommand}"
                    Margin="0,0,8,0"
                    Padding="12,4"
                    IsDefault="True" />
            <Button Content="Clone for me…"
                    Command="{Binding CloneForMeCommand}"
                    Margin="0,0,8,0"
                    Padding="12,4" />
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Padding="12,4"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
