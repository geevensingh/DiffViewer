<UserControl x:Class="DiffViewer.Views.FileListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DiffViewer.ViewModels"
             xmlns:views="clr-namespace:DiffViewer.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:FileListViewModel}"
             mc:Ignorable="d"
             Background="White">

    <UserControl.Resources>
        <SolidColorBrush x:Key="HeaderFgBrush"  Color="#424242"/>
        <SolidColorBrush x:Key="SectionBgBrush" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="DimFgBrush"     Color="#909090"/>
        <SolidColorBrush x:Key="BadgeBgBrush"   Color="#E8E8E8"/>

        <!-- Viewed-indicator chrome (issue #3 polish). Deep teal reads
             distinctly against the white row background and the grey
             section header band without colliding with any of the
             existing palette swatches. -->
        <!-- Viewed-checkbox chrome. Uses the app's existing Fluent
             blue (#0078D4) — the same accent the diff toolbar's
             active-toggle borders use, and the same blue as the
             hunk-bar viewport. Hover darkens to #106EBE. Picked
             over teal (which had been borrowed from the design
             mockup) because (a) the app's UI accent is already
             this blue everywhere and a viewed checkbox is just
             another action toggle, and (b) the teal #0F766E we
             previously used sat dangerously close to #138672
             which is `RefAccentRight` — the semantic colour for
             the diff's right side. Reusing a side-semantic colour
             for a non-side concern would be misleading. -->
        <SolidColorBrush x:Key="ViewedAccentBrush"       Color="#0078D4"/>
        <SolidColorBrush x:Key="ViewedAccentHoverBrush"  Color="#106EBE"/>
        <SolidColorBrush x:Key="ViewedBorderBrush"       Color="#BBBBBB"/>

        <!-- Custom CheckBox chrome for the per-row "viewed" toggle.
             Default WPF chrome reads as dated next to the lean section
             chrome; this template paints a 14x14 rounded square with a
             Path-based checkmark when checked. Hover-reveal opacity
             behaviour lives on the per-instance Style below (so the
             chrome resource can be reused if we ever need a non-revealed
             variant). -->
        <Style x:Key="ViewedToggleStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box"
                                Width="14" Height="14"
                                CornerRadius="2"
                                BorderBrush="{StaticResource ViewedBorderBrush}"
                                BorderThickness="1.2"
                                Background="Transparent"
                                SnapsToDevicePixels="True">
                            <Path x:Name="Check"
                                  Stretch="Uniform"
                                  Margin="2"
                                  Stroke="White"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M 0,4 L 3,7 L 9,1"
                                  Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush"
                                        Value="{StaticResource ViewedAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background"
                                        Value="{StaticResource ViewedAccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush"
                                        Value="{StaticResource ViewedAccentBrush}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Box" Property="Background"
                                        Value="{StaticResource ViewedAccentHoverBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush"
                                        Value="{StaticResource ViewedAccentHoverBrush}"/>
                            </MultiTrigger>
                            <!-- High-contrast variant for rows whose
                                 TreeViewItem is currently selected AND
                                 the selection is active (the TreeView
                                 has focus). The system paints the
                                 highlight colour (typically Windows
                                 blue) in that state, and a teal-on-blue
                                 checkbox is hard to read. Switch to a
                                 transparent box with white border +
                                 white check; that reads cleanly against
                                 the highlight in both checked (white
                                 outline + white tick) and unchecked
                                 (just the white outline) states.

                                 When the selection goes inactive
                                 (file list loses focus), WPF repaints
                                 the row with a light-grey inactive
                                 highlight — white-on-grey is the worst
                                 of both worlds, so we drop back to the
                                 default teal chrome which contrasts
                                 fine against the grey.

                                 Listed after the IsChecked trigger so
                                 its setters override the teal fill. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}" Value="True"/>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=(Selector.IsSelectionActive)}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Box" Property="Background" Value="Transparent"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="Check" Property="Stroke" Value="White"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Right-click context menu shared by every file row. The menu's
             DataContext is the FileEntryViewModel (because the row is the
             PlacementTarget). Commands live on MainViewModel - we walk up
             through the Window's DataContext via PlacementTarget.Tag, which
             we set on the row's container so the visual tree is rooted at
             a known anchor regardless of which display mode the user is in. -->
        <ContextMenu x:Key="FileEntryContextMenu"
                     d:DataContext="{d:DesignInstance Type=vm:FileEntryViewModel}">
            <MenuItem Header="Show in Explorer"
                      Command="{Binding PlacementTarget.Tag.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"
                      Visibility="{Binding ExistsOnDisk, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"/>
            <MenuItem Header="Open with default app"
                      Command="{Binding PlacementTarget.Tag.OpenWithDefaultAppCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"
                      Visibility="{Binding ExistsOnDisk, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"/>
            <MenuItem Header="Open in external editor…"
                      Command="{Binding PlacementTarget.Tag.OpenInExternalEditorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ExistsOnDisk}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ShouldHideOpenInExternalEditor}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>

            <Separator>
                <Separator.Visibility>
                    <Binding Path="HasFileWriteAction" Converter="{x:Static vm:BoolToVisibilityConverter.Instance}"/>
                </Separator.Visibility>
            </Separator>
            <MenuItem Header="Stage file"
                      Command="{Binding PlacementTarget.Tag.StageFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"
                      Visibility="{Binding CanStageWholeFile, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"/>
            <MenuItem Header="Unstage file"
                      Command="{Binding PlacementTarget.Tag.UnstageFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"
                      Visibility="{Binding CanUnstageWholeFile, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"/>
            <MenuItem Header="Revert file…"
                      Command="{Binding PlacementTarget.Tag.RevertFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"
                      Visibility="{Binding CanRevertWholeFile, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"/>
            <MenuItem Header="Delete file…"
                      Command="{Binding PlacementTarget.Tag.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"
                      Visibility="{Binding IsUntracked, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"/>
            <MenuItem Header="Add to .gitignore"
                      Command="{Binding PlacementTarget.Tag.AddToGitignoreCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"
                      Visibility="{Binding IsUntracked, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"/>

            <Separator/>
            <MenuItem Header="Copy file name"
                      Command="{Binding PlacementTarget.Tag.CopyFileNameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"/>
            <MenuItem Header="Copy repo-relative path"
                      Command="{Binding PlacementTarget.Tag.CopyRepoRelativePathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"/>
            <MenuItem Header="Copy full path"
                      Command="{Binding PlacementTarget.Tag.CopyFullPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"/>

            <Separator/>
            <MenuItem Header="Copy blob SHA (left)"
                      Command="{Binding PlacementTarget.Tag.CopyLeftBlobShaCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"
                      Visibility="{Binding HasLeftBlobSha, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"/>
            <MenuItem Header="Copy blob SHA (right)"
                      Command="{Binding PlacementTarget.Tag.CopyRightBlobShaCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"
                      Visibility="{Binding HasRightBlobSha, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"/>

            <Separator/>
            <MenuItem Header="Refresh"
                      Command="{Binding PlacementTarget.Tag.RefreshListCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      InputGestureText="F5"/>
        </ContextMenu>

        <!-- Row template - shared by every file row in the unified TreeView,
             regardless of display mode. -->
        <DataTemplate x:Key="EntryTemplate" DataType="{x:Type vm:FileEntryViewModel}">
            <Grid ContextMenu="{StaticResource FileEntryContextMenu}"
                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource BadgeBgBrush}"
                        CornerRadius="3"
                        Padding="4,1"
                        Margin="0,0,6,0"
                        MinWidth="22">
                    <TextBlock Text="{Binding StatusBadge}"
                               FontFamily="Consolas"
                               FontWeight="SemiBold"
                               FontSize="11"
                               HorizontalAlignment="Center"/>
                </Border>

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DimFgBrush}"/>
                                </DataTrigger>
                                <!-- Active selection (file list focused →
                                     row paints the system highlight blue):
                                     swap text to white for contrast.
                                     MUST come after the IsDimmed trigger
                                     so it overrides DimFgBrush when both
                                     conditions apply (a viewed-and-
                                     selected row should still read white,
                                     not grey-on-blue). When focus moves
                                     out of the file list the row paints
                                     the inactive-selection light grey
                                     instead, and the default dark
                                     foreground reads fine there — so we
                                     gate on Selector.IsSelectionActive. -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}" Value="True"/>
                                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=(Selector.IsSelectionActive)}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Foreground" Value="White"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="{Binding DisplayPath, Mode=OneWay}"/><Run x:Name="RenameDescriptorRun"
                                                                        Text="{Binding RenameDescriptor, Mode=OneWay}"
                                                                        Foreground="{StaticResource DimFgBrush}"/>
                </TextBlock>

                <!-- GitHub-PR-review-style viewed checkbox (issue #3,
                     polished). Custom chrome (ViewedToggleStyle) replaces
                     default WPF chrome; per-instance Style here layers
                     hover-reveal on top so the checkbox is invisible at
                     rest, fades in on row hover, and persists when
                     checked. PreviewMouseDown / PreviewMouseUp are
                     marked handled in code-behind so the click doesn't
                     bubble to the TreeViewItem and steal selection /
                     scroll-into-view. ToolTip flips by IsChecked so
                     the user sees the action that will happen on click. -->
                <CheckBox Grid.Column="2"
                          IsChecked="{Binding IsViewed, Mode=TwoWay}"
                          Margin="6,0,2,0"
                          PreviewMouseLeftButtonDown="OnViewedCheckBoxPreviewMouse"
                          PreviewMouseLeftButtonUp="OnViewedCheckBoxPreviewMouse">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox" BasedOn="{StaticResource ViewedToggleStyle}">
                            <Setter Property="ToolTip" Value="Mark as viewed (Space)"/>
                            <Setter Property="Opacity" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="ToolTip" Value="Mark as not viewed (Space)"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsMouseOver}" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                                <!-- A selected row exposes its actions even
                                     without the cursor over it (keyboard
                                     navigation lands the user on a row
                                     without hovering — and that user still
                                     needs to see the viewed toggle to
                                     mouse-click it). -->
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>
            </Grid>
        </DataTemplate>

        <!-- Tree-view template - directory nodes show their label and recurse. -->
        <HierarchicalDataTemplate x:Key="DirectoryTemplate"
                                  DataType="{x:Type vm:DirectoryNodeViewModel}"
                                  ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Label}"
                       Foreground="{StaticResource HeaderFgBrush}"
                       FontWeight="SemiBold"/>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- Filter + Hide-viewed bar (issue #3). Filter is repo-relative,
             case-insensitive substring, slash-insensitive. Esc clears
             and returns focus to the file list; Ctrl+/ at the Window
             level focuses this TextBox via MainViewModel.FocusFilterCommand
             (the handler is wired in code-behind). Hide-viewed composes
             with the filter as AND. -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SectionBgBrush}"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1"
                Padding="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Filter cell: TextBox underneath, placeholder hint and
                     clear-X button overlaid on top. IsHitTestVisible=False
                     on the placeholder lets clicks land on the TextBox.
                     The X button gets HorizontalAlignment=Right so it
                     hugs the trailing edge of the textbox cell regardless
                     of the cell's actual width. -->
                <Grid Grid.Column="0">
                    <TextBox x:Name="FilterBox"
                             Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"
                             Padding="4,2,22,2"
                             KeyDown="OnFilterKeyDown"
                             ToolTip="Filter files (Ctrl+/) — case-insensitive substring, repo-relative path"/>
                    <TextBlock IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"
                               Foreground="{StaticResource DimFgBrush}"
                               FontStyle="Italic"
                               Text="Filter files…  Ctrl+/">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button x:Name="FilterClearButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0"
                            Width="16" Height="16"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Focusable="False"
                            ToolTip="Clear filter (Esc)"
                            Click="OnFilterClearClick">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ClearBg"
                                                    Background="Transparent"
                                                    CornerRadius="8">
                                                <Path x:Name="ClearGlyph"
                                                      Stretch="Uniform"
                                                      Margin="4"
                                                      Stroke="{StaticResource DimFgBrush}"
                                                      StrokeThickness="1.4"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Data="M 0,0 L 8,8 M 8,0 L 0,8"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ClearBg" Property="Background" Value="#E0E0E0"/>
                                                    <Setter TargetName="ClearGlyph" Property="Stroke" Value="{StaticResource HeaderFgBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilterText, Converter={x:Static vm:StringNotEmptyToBoolConverter.Instance}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                <ToggleButton Grid.Column="1"
                              Content="Hide viewed"
                              IsChecked="{Binding HideViewed, Mode=TwoWay}"
                              Margin="6,0,0,0"
                              Padding="8,2"
                              ToolTip="Hide files marked viewed"
                              Visibility="{Binding HasAnyViewed, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"/>
            </Grid>
        </Border>

        <!-- Display-mode toggle bar -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SectionBgBrush}"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1"
                Padding="6">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Full path"
                             GroupName="DisplayMode"
                             Margin="0,0,8,0"
                             IsChecked="{Binding IsFullPathMode, Mode=TwoWay}"/>
                <RadioButton Content="Repo-relative"
                             GroupName="DisplayMode"
                             Margin="0,0,8,0"
                             IsChecked="{Binding IsRepoRelativeMode, Mode=TwoWay}"/>
                <RadioButton Content="Grouped by directory"
                             GroupName="DisplayMode"
                             IsChecked="{Binding IsGroupedByDirectoryMode, Mode=TwoWay}"/>
            </StackPanel>
        </Border>

        <!-- Unified TreeView. Top-level branches are the per-layer
             sections; their children are either the section's files
             directly (flat modes) or the section's RootItems
             (grouped-by-directory mode — root directories plus any
             repo-root files as siblings), projected via
             FileListSectionViewModel.Children. One Selector means
             selection state lives in exactly one place, so cross-section
             click-throughs don't go stale. ItemContainerStyleSelector
             applies per-tier styles because each VM type binds different
             state (sections use SharedHeader.IsExpanded, directories use
             their own IsExpanded, files use IsSelected). -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <!-- ScrollViewer.HorizontalScrollBarVisibility=Disabled on
                 the TreeView (the attached-property setter below) is
                 load-bearing for the per-row layout: TreeView has its
                 own internal ScrollViewer in its default template and
                 that's the one measuring each TreeViewItem's available
                 width. Disabling its horizontal scroll forces it to
                 measure items with the viewport width rather than
                 infinite, so the FileStyle's
                 HorizontalContentAlignment=Stretch can actually push the
                 viewed-toggle checkbox to the right edge of the row.
                 Without this, every TreeViewItem renders at its content's
                 natural width and the checkbox sits flush against the
                 filename. Long filenames ellipsize via TextTrimming on
                 the filename TextBlock, so losing horizontal scroll
                 costs nothing in practice. The outer ScrollViewer's HSB
                 is also disabled for symmetry. -->
            <TreeView x:Name="FilesTree"
                      ItemsSource="{Binding Sections}"
                      BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      KeyDown="OnTreeKeyDown">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type vm:FileListSectionViewModel}"
                                              ItemsSource="{Binding Children}">
                        <!-- Section header text. Runs inherit Foreground
                             from the parent TextBlock so a single Style
                             trigger flips all three (label + " (" + count
                             + ")") together when the row is the active
                             selection. -->
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource HeaderFgBrush}"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}" Value="True"/>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=(Selector.IsSelectionActive)}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Foreground" Value="White"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="{Binding Header, Mode=OneWay}"
                                 FontWeight="Bold"/>
                            <Run Text=" ("/>
                            <Run Text="{Binding CountChipText, Mode=OneWay}"/>
                            <Run Text=")"/>
                        </TextBlock>
                    </HierarchicalDataTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:DirectoryNodeViewModel}"
                                              ItemsSource="{Binding ChildrenAndFiles}">
                        <TextBlock Text="{Binding Label}"
                                   FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource HeaderFgBrush}"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}" Value="True"/>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=(Selector.IsSelectionActive)}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Foreground" Value="White"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </HierarchicalDataTemplate>
                    <DataTemplate DataType="{x:Type vm:FileEntryViewModel}">
                        <ContentPresenter Content="{Binding}"
                                          ContentTemplate="{StaticResource EntryTemplate}"/>
                    </DataTemplate>
                </TreeView.Resources>
                <TreeView.ItemContainerStyleSelector>
                    <views:FileListItemContainerStyleSelector>
                        <!-- Section and directory styles wire MouseLeftButtonUp
                             so clicking the header (not the chevron) toggles
                             expand, mirroring the affordance the old flat-mode
                             Expander had. PreviewMouseRightButtonDown is
                             suppressed because no context menu is wired here
                             and a right-click selection highlight on an inert
                             row reads as misleading feedback. The toggle
                             handler walks the visual tree from
                             e.OriginalSource so a click that originated inside
                             the chevron ToggleButton is left alone (its own
                             ToggleButton handler will toggle once).

                             IsVisible→Collapsed DataTriggers implement the
                             filter / Hide-viewed collapse: when a section,
                             directory, or file row has no business being on
                             screen the TreeViewItem disappears entirely.
                             Collapse-by-visibility is independent of the
                             user-driven IsExpanded collapse, so expand
                             state survives a filter toggle. -->
                        <views:FileListItemContainerStyleSelector.SectionStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding SharedHeader.IsExpanded, Mode=TwoWay}"/>
                                <EventSetter Event="MouseLeftButtonUp"
                                             Handler="OnHeaderLeftMouseUp"/>
                                <EventSetter Event="PreviewMouseRightButtonDown"
                                             Handler="OnHeaderRightMouseDown"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:FileListItemContainerStyleSelector.SectionStyle>
                        <views:FileListItemContainerStyleSelector.DirectoryStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <EventSetter Event="MouseLeftButtonUp"
                                             Handler="OnHeaderLeftMouseUp"/>
                                <EventSetter Event="PreviewMouseRightButtonDown"
                                             Handler="OnHeaderRightMouseDown"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:FileListItemContainerStyleSelector.DirectoryStyle>
                        <views:FileListItemContainerStyleSelector.FileStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <!-- Custom ControlTemplate for file rows.
                                     The default WPF TreeViewItem template
                                     puts its content Border in a
                                     Grid.Column=1 with ColumnSpan=2 over
                                     [19px expander, Auto, *]. The Auto+*
                                     ColumnSpan trips the well-known WPF
                                     Grid gotcha where the spanned child
                                     is measured with infinite width, so
                                     our EntryTemplate's * column for the
                                     filename collapses to text-natural
                                     width and the trailing viewed-toggle
                                     ends up flush against the filename
                                     instead of flush right. This template
                                     uses a clean [19px indent, *] grid so
                                     the row content gets a finite width
                                     and the * column expands properly.
                                     Files have no children so we don't
                                     need an expander toggle. Selection
                                     background uses the system highlight
                                     brushes to match the rest of the app
                                     and stay theme-aware. -->
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TreeViewItem">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="19"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="Bd"
                                                        Grid.Column="1"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter x:Name="PART_Header"
                                                                      ContentSource="Header"
                                                                      HorizontalAlignment="Stretch"
                                                                      VerticalAlignment="Center"
                                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                </Border>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsSelected" Value="True"/>
                                                        <Condition Property="IsSelectionActive" Value="False"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:FileListItemContainerStyleSelector.FileStyle>
                    </views:FileListItemContainerStyleSelector>
                </TreeView.ItemContainerStyleSelector>
            </TreeView>
        </ScrollViewer>
    </DockPanel>
</UserControl>
