<UserControl x:Class="DiffViewer.Views.FileListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DiffViewer.ViewModels"
             xmlns:views="clr-namespace:DiffViewer.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:FileListViewModel}"
             mc:Ignorable="d"
             Background="White">

    <UserControl.Resources>
        <SolidColorBrush x:Key="HeaderFgBrush"  Color="#424242"/>
        <SolidColorBrush x:Key="SectionBgBrush" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="DimFgBrush"     Color="#909090"/>
        <SolidColorBrush x:Key="BadgeBgBrush"   Color="#E8E8E8"/>

        <!-- Right-click context menu shared by every file row. The menu's
             DataContext is the FileEntryViewModel (because the row is the
             PlacementTarget). Commands live on MainViewModel - we walk up
             through the Window's DataContext via PlacementTarget.Tag, which
             we set on the row's container so the visual tree is rooted at
             a known anchor regardless of which display mode the user is in. -->
        <ContextMenu x:Key="FileEntryContextMenu"
                     d:DataContext="{d:DesignInstance Type=vm:FileEntryViewModel}">
            <MenuItem Header="Show in Explorer"
                      Command="{Binding PlacementTarget.Tag.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"
                      Visibility="{Binding ExistsOnDisk, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"/>
            <MenuItem Header="Open with default app"
                      Command="{Binding PlacementTarget.Tag.OpenWithDefaultAppCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"
                      Visibility="{Binding ExistsOnDisk, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"/>
            <MenuItem Header="Open in external editor…"
                      Command="{Binding PlacementTarget.Tag.OpenInExternalEditorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ExistsOnDisk}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ShouldHideOpenInExternalEditor}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>

            <Separator>
                <Separator.Visibility>
                    <Binding Path="HasFileWriteAction" Converter="{x:Static vm:BoolToVisibilityConverter.Instance}"/>
                </Separator.Visibility>
            </Separator>
            <MenuItem Header="Stage file"
                      Command="{Binding PlacementTarget.Tag.StageFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"
                      Visibility="{Binding CanStageWholeFile, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"/>
            <MenuItem Header="Unstage file"
                      Command="{Binding PlacementTarget.Tag.UnstageFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"
                      Visibility="{Binding CanUnstageWholeFile, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"/>
            <MenuItem Header="Revert file…"
                      Command="{Binding PlacementTarget.Tag.RevertFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"
                      Visibility="{Binding CanRevertWholeFile, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"/>
            <MenuItem Header="Delete file…"
                      Command="{Binding PlacementTarget.Tag.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"
                      Visibility="{Binding IsUntracked, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"/>
            <MenuItem Header="Add to .gitignore"
                      Command="{Binding PlacementTarget.Tag.AddToGitignoreCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"
                      Visibility="{Binding IsUntracked, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"/>

            <Separator/>
            <MenuItem Header="Copy file name"
                      Command="{Binding PlacementTarget.Tag.CopyFileNameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"/>
            <MenuItem Header="Copy repo-relative path"
                      Command="{Binding PlacementTarget.Tag.CopyRepoRelativePathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"/>
            <MenuItem Header="Copy full path"
                      Command="{Binding PlacementTarget.Tag.CopyFullPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"/>

            <Separator/>
            <MenuItem Header="Copy blob SHA (left)"
                      Command="{Binding PlacementTarget.Tag.CopyLeftBlobShaCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"
                      Visibility="{Binding HasLeftBlobSha, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"/>
            <MenuItem Header="Copy blob SHA (right)"
                      Command="{Binding PlacementTarget.Tag.CopyRightBlobShaCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"
                      Visibility="{Binding HasRightBlobSha, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"/>

            <Separator/>
            <MenuItem Header="Refresh"
                      Command="{Binding PlacementTarget.Tag.RefreshListCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      InputGestureText="F5"/>
        </ContextMenu>

        <!-- Row template - shared by every file row in the unified TreeView,
             regardless of display mode. -->
        <DataTemplate x:Key="EntryTemplate" DataType="{x:Type vm:FileEntryViewModel}">
            <Grid ContextMenu="{StaticResource FileEntryContextMenu}"
                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource BadgeBgBrush}"
                        CornerRadius="3"
                        Padding="4,1"
                        Margin="0,0,6,0"
                        MinWidth="22">
                    <TextBlock Text="{Binding StatusBadge}"
                               FontFamily="Consolas"
                               FontWeight="SemiBold"
                               FontSize="11"
                               HorizontalAlignment="Center"/>
                </Border>

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWhitespaceOnly}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DimFgBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="{Binding DisplayPath, Mode=OneWay}"/><Run Text="{Binding RenameDescriptor, Mode=OneWay}"
                                                                        Foreground="{StaticResource DimFgBrush}"/>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <!-- Tree-view template - directory nodes show their label and recurse. -->
        <HierarchicalDataTemplate x:Key="DirectoryTemplate"
                                  DataType="{x:Type vm:DirectoryNodeViewModel}"
                                  ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Label}"
                       Foreground="{StaticResource HeaderFgBrush}"
                       FontWeight="SemiBold"/>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- Display-mode toggle bar -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SectionBgBrush}"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1"
                Padding="6">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Full path"
                             GroupName="DisplayMode"
                             Margin="0,0,8,0"
                             IsChecked="{Binding IsFullPathMode, Mode=TwoWay}"/>
                <RadioButton Content="Repo-relative"
                             GroupName="DisplayMode"
                             Margin="0,0,8,0"
                             IsChecked="{Binding IsRepoRelativeMode, Mode=TwoWay}"/>
                <RadioButton Content="Grouped by directory"
                             GroupName="DisplayMode"
                             IsChecked="{Binding IsGroupedByDirectoryMode, Mode=TwoWay}"/>
            </StackPanel>
        </Border>

        <!-- Unified TreeView. Top-level branches are the per-layer
             sections; their children are either the section's files
             directly (flat modes) or the section's RootItems
             (grouped-by-directory mode — root directories plus any
             repo-root files as siblings), projected via
             FileListSectionViewModel.Children. One Selector means
             selection state lives in exactly one place, so cross-section
             click-throughs don't go stale. ItemContainerStyleSelector
             applies per-tier styles because each VM type binds different
             state (sections use SharedHeader.IsExpanded, directories use
             their own IsExpanded, files use IsSelected). -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <TreeView ItemsSource="{Binding Sections}"
                      BorderThickness="0"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type vm:FileListSectionViewModel}"
                                              ItemsSource="{Binding Children}">
                        <TextBlock>
                            <Run Text="{Binding Header, Mode=OneWay}"
                                 FontWeight="Bold"
                                 Foreground="{StaticResource HeaderFgBrush}"/>
                            <Run Text=" ("/>
                            <Run Text="{Binding Entries.Count, Mode=OneWay}"/>
                            <Run Text=")"/>
                        </TextBlock>
                    </HierarchicalDataTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:DirectoryNodeViewModel}"
                                              ItemsSource="{Binding ChildrenAndFiles}">
                        <TextBlock Text="{Binding Label}"
                                   Foreground="{StaticResource HeaderFgBrush}"
                                   FontWeight="SemiBold"/>
                    </HierarchicalDataTemplate>
                    <DataTemplate DataType="{x:Type vm:FileEntryViewModel}">
                        <ContentPresenter Content="{Binding}"
                                          ContentTemplate="{StaticResource EntryTemplate}"/>
                    </DataTemplate>
                </TreeView.Resources>
                <TreeView.ItemContainerStyleSelector>
                    <views:FileListItemContainerStyleSelector>
                        <!-- Section and directory styles wire MouseLeftButtonUp
                             so clicking the header (not the chevron) toggles
                             expand, mirroring the affordance the old flat-mode
                             Expander had. PreviewMouseRightButtonDown is
                             suppressed because no context menu is wired here
                             and a right-click selection highlight on an inert
                             row reads as misleading feedback. The toggle
                             handler walks the visual tree from
                             e.OriginalSource so a click that originated inside
                             the chevron ToggleButton is left alone (its own
                             ToggleButton handler will toggle once). -->
                        <views:FileListItemContainerStyleSelector.SectionStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding SharedHeader.IsExpanded, Mode=TwoWay}"/>
                                <EventSetter Event="MouseLeftButtonUp"
                                             Handler="OnHeaderLeftMouseUp"/>
                                <EventSetter Event="PreviewMouseRightButtonDown"
                                             Handler="OnHeaderRightMouseDown"/>
                            </Style>
                        </views:FileListItemContainerStyleSelector.SectionStyle>
                        <views:FileListItemContainerStyleSelector.DirectoryStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <EventSetter Event="MouseLeftButtonUp"
                                             Handler="OnHeaderLeftMouseUp"/>
                                <EventSetter Event="PreviewMouseRightButtonDown"
                                             Handler="OnHeaderRightMouseDown"/>
                            </Style>
                        </views:FileListItemContainerStyleSelector.DirectoryStyle>
                        <views:FileListItemContainerStyleSelector.FileStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            </Style>
                        </views:FileListItemContainerStyleSelector.FileStyle>
                    </views:FileListItemContainerStyleSelector>
                </TreeView.ItemContainerStyleSelector>
            </TreeView>
        </ScrollViewer>
    </DockPanel>
</UserControl>
