<Window x:Class="DiffViewer.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DiffViewer.ViewModels"
        xmlns:util="clr-namespace:DiffViewer.Utility"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        mc:Ignorable="d"
        Title="DiffViewer settings"
        Width="640" Height="780"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Margin" Value="0,4,8,2"/>
        </Style>
        <CollectionViewSource x:Key="GroupedFonts" Source="{Binding AvailableFonts}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupName"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <DockPanel Margin="14">

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="Open settings.json" Margin="0,0,8,0" Padding="10,4"
                            Command="{Binding OpenSettingsJsonCommand}"/>
                    <Button Content="Reset all to defaults" Padding="10,4"
                            Command="{Binding ResetAllToDefaultsCommand}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Close" Padding="16,4" IsCancel="True" IsDefault="True"
                        Click="OnCloseClick"/>
            </Grid>
        </Border>

        <!-- Status line -->
        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" FontStyle="Italic" Foreground="#666"
                   Text="{Binding StatusMessage}"/>

        <!-- Body -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Diff appearance -->
                <TextBlock Text="Diff appearance" Style="{StaticResource SectionHeader}"/>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/>
                        <RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Font family"/>
                    <ComboBox  Grid.Row="0" Grid.Column="1" Margin="0,4"
                               IsEditable="True"
                               IsTextSearchEnabled="True"
                               IsTextSearchCaseSensitive="False"
                               TextSearch.TextPath="Name"
                               MaxDropDownHeight="320"
                               ItemsSource="{Binding Source={StaticResource GroupedFonts}}"
                               Text="{Binding FontFamily, UpdateSourceTrigger=LostFocus}"
                               SelectionChanged="OnFontFamilySelectionChanged"
                               LostFocus="OnTextOrNumericLostFocus"
                               KeyDown="OnTextOrNumericKeyDown">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontFamily="{Binding Name}" FontSize="13"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <ComboBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="2,4,2,3" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#666" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ComboBox.GroupStyle>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Font size (pt)"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                        <TextBox Width="80"
                                 Text="{Binding FontSize, UpdateSourceTrigger=LostFocus}"
                                 LostFocus="OnTextOrNumericLostFocus" KeyDown="OnTextOrNumericKeyDown"
                                 PreviewTextInput="OnDecimalTextInput"
                                 DataObject.Pasting="OnDecimalPasting"/>
                        <TextBlock Text=" pt (6 – 72)" Margin="6,4,0,0" Foreground="#666"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Tab width"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                        <TextBox Width="80"
                                 Text="{Binding TabWidth, UpdateSourceTrigger=LostFocus}"
                                 LostFocus="OnTextOrNumericLostFocus" KeyDown="OnTextOrNumericKeyDown"
                                 PreviewTextInput="OnIntegerTextInput"
                                 DataObject.Pasting="OnIntegerPasting"/>
                        <TextBlock Text=" spaces (1 – 16)" Margin="6,4,0,0" Foreground="#666"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Show line numbers"/>
                    <CheckBox  Grid.Row="3" Grid.Column="1" Margin="0,6" IsChecked="{Binding ShowLineNumbers}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Word wrap"/>
                    <CheckBox  Grid.Row="4" Grid.Column="1" Margin="0,6" IsChecked="{Binding WordWrap}"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Color scheme"/>
                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                        <ComboBox Width="220" ItemsSource="{Binding ColorSchemePresets}"
                                  SelectedItem="{Binding SelectedColorPreset}"
                                  IsEnabled="{Binding IsCustomColorScheme, Converter={x:Static vm:InverseBoolConverter.Instance}}"/>
                        <TextBlock Margin="10,4,0,0" Foreground="#888" FontStyle="Italic"
                                   Visibility="{Binding IsCustomColorScheme, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                   Text="Custom (edit settings.json)"/>
                    </StackPanel>
                </Grid>

                <!-- External editor -->
                <TextBlock Text="External editor" Style="{StaticResource SectionHeader}"/>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Editor executable"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" Margin="0,4"
                               Text="{Binding ExternalEditorPath, UpdateSourceTrigger=LostFocus}"
                               LostFocus="OnTextOrNumericLostFocus" KeyDown="OnTextOrNumericKeyDown"
                               ToolTip="Empty = auto-detect (where.exe code, then well-known install paths)"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Line-arg format"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,4"
                               Text="{Binding ExternalEditorLineArgFormat, UpdateSourceTrigger=LostFocus}"
                               LostFocus="OnTextOrNumericLostFocus" KeyDown="OnTextOrNumericKeyDown"
                               ToolTip="e.g. --goto {path}:{line}; empty = use the resolved editor's default"/>
                </Grid>

                <!-- Limits -->
                <TextBlock Text="Limits" Style="{StaticResource SectionHeader}"/>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Skip files larger than"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                        <TextBox Width="80"
                                 Text="{Binding LargeFileThresholdMb, UpdateSourceTrigger=LostFocus}"
                                 LostFocus="OnTextOrNumericLostFocus" KeyDown="OnTextOrNumericKeyDown"
                                 PreviewTextInput="OnIntegerTextInput"
                                 DataObject.Pasting="OnIntegerPasting"/>
                        <TextBlock Text=" MB (1 – 2048)" Margin="6,4,0,0" Foreground="#666"/>
                    </StackPanel>
                </Grid>

                <!-- Confirmations -->
                <TextBlock Text="Confirmations" Style="{StaticResource SectionHeader}"/>

                <CheckBox Content="Confirm before reverting a hunk" Margin="0,4"
                          IsChecked="{Binding ConfirmRevertHunk}"/>
                <CheckBox Content="Confirm before deleting an untracked file" Margin="0,4"
                          IsChecked="{Binding ConfirmDeleteFile}"/>

                <!-- Pull-request review -->
                <TextBlock Text="Pull-request review" Style="{StaticResource SectionHeader}"/>

                <TextBlock Text="Repo roots" Margin="0,4,0,2" Foreground="#666"/>
                <TextBlock Margin="0,0,0,4" Foreground="#888" TextWrapping="Wrap" FontStyle="Italic">
                    DiffViewer scans each root's immediate subdirectories for a local clone
                    matching a PR URL's owner/repo. Pick the parent folder where you keep your
                    clones (e.g. C:\Repos).
                </TextBlock>
                <Grid Margin="0,2,0,4">
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <ListBox Grid.Row="0" Height="100"
                             ItemsSource="{Binding RepoRoots}"
                             SelectedItem="{Binding SelectedRepoRoot}"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Add..." Padding="10,3" Margin="0,0,6,0"
                                Command="{Binding AddRepoRootCommand}"/>
                        <Button Content="Remove" Padding="10,3" Margin="0,0,6,0"
                                Command="{Binding RemoveRepoRootCommand}"
                                CommandParameter="{Binding SelectedRepoRoot}"/>
                        <Button Content="Move up" Padding="10,3" Margin="0,0,6,0"
                                Command="{Binding MoveRepoRootUpCommand}"
                                CommandParameter="{Binding SelectedRepoRoot}"/>
                        <Button Content="Move down" Padding="10,3"
                                Command="{Binding MoveRepoRootDownCommand}"
                                CommandParameter="{Binding SelectedRepoRoot}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Default clone destination" Margin="0,10,0,2" Foreground="#666"/>
                <TextBlock Margin="0,0,0,4" Foreground="#888" TextWrapping="Wrap" FontStyle="Italic">
                    Optional. When DiffViewer offers to clone a missing repo for you, the
                    destination picker is pre-filled with this folder. Leave empty to be
                    prompted each time.
                </TextBlock>
                <Grid Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" IsReadOnly="True" Padding="4,2"
                             Text="{Binding DefaultCloneDestination, Mode=OneWay}"/>
                    <Button Grid.Column="1" Content="Browse..." Padding="10,3" Margin="6,0,0,0"
                            Command="{Binding BrowseDefaultCloneDestinationCommand}"/>
                    <Button Grid.Column="2" Content="Clear" Padding="10,3" Margin="6,0,0,0"
                            Command="{Binding ClearDefaultCloneDestinationCommand}"
                            IsEnabled="{Binding HasDefaultCloneDestination}"/>
                </Grid>

                <TextBlock Text="Remembered clones" Margin="0,10,0,2" Foreground="#666"/>
                <TextBlock Margin="0,0,0,4" Foreground="#888" TextWrapping="Wrap" FontStyle="Italic">
                    Explicit mappings DiffViewer recorded when you pointed it at a clone outside
                    your repo roots. "Forget" clears the entry — you'll be prompted again the
                    next time you open a PR from that repo.
                </TextBlock>
                <ItemsControl ItemsSource="{Binding RepoUrlMappings}" Margin="0,2,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DisplayKey}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Path}" Foreground="#666" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Forget" Padding="10,3" VerticalAlignment="Center"
                                            Command="{Binding DataContext.ForgetRepoUrlMappingCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,4,0,0" FontStyle="Italic" Foreground="#888"
                           Visibility="{Binding RepoUrlMappings.Count,
                                                Converter={x:Static vm:ZeroToVisibleConverter.Instance}}"
                           Text="No remembered clones yet."/>

                <!-- Updates (added in v7) -->
                <TextBlock Text="Updates" Style="{StaticResource SectionHeader}"/>
                <TextBlock Margin="0,0,0,6" Foreground="#666" TextWrapping="Wrap" FontStyle="Italic">
                    DiffViewer can check GitHub Releases for a newer version. The check
                    only runs when launched from a Velopack-installed copy; portable
                    builds ignore these settings.
                </TextBlock>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"
                               Text="Auto-update behavior"/>
                    <ComboBox  Grid.Row="0" Grid.Column="1" Margin="0,4"
                               ItemsSource="{Binding AutoUpdateOptions}"
                               SelectedItem="{Binding AutoUpdate}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static util:EnumDisplayConverter.Instance}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}"
                               Text="Check frequency"/>
                    <ComboBox  Grid.Row="1" Grid.Column="1" Margin="0,4"
                               ItemsSource="{Binding UpdateCheckCadenceOptions}"
                               SelectedItem="{Binding UpdateCheckCadence}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static util:EnumDisplayConverter.Instance}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <CheckBox  Grid.Row="2" Grid.Column="1" Margin="0,6,0,0"
                               Content="Include pre-release versions"
                               IsChecked="{Binding IncludePreReleases}"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
