<Window x:Class="DiffViewer.Views.NewDiffDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DiffViewer.ViewModels"
        xmlns:vw="clr-namespace:DiffViewer.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:NewDiffDialogViewModel}"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="640" Height="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Margin" Value="0,8,0,2"/>
            <Setter Property="Foreground" Value="#444"/>
        </Style>
        <Style TargetType="TextBox" x:Key="FieldInput">
            <Setter Property="Padding" Value="4,3"/>
        </Style>
        <!-- "Pick…" ToggleButton next to each commit-ish input. Looks
             like a small button; its IsChecked state drives the
             adjacent RefPicker.IsOpen so click toggles the popup. -->
        <Style TargetType="ToggleButton" x:Key="PickToggle">
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Content" Value="Pick…"/>
            <Setter Property="MinWidth" Value="60"/>
        </Style>

        <!-- "Working tree vs HEAD" form. -->
        <DataTemplate DataType="{x:Type vm:WorkingTreeVsHeadFormViewModel}">
            <StackPanel>
                <TextBlock Text="Repository path"
                           Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Style="{StaticResource FieldInput}"
                             Text="{Binding RepoPath, UpdateSourceTrigger=PropertyChanged}"
                             Tag="RepoPath"/>
                    <Button Grid.Column="1"
                            Content="Browse…"
                            Margin="6,0,0,0" Padding="10,4"
                            Click="OnBrowseRepoPathClick"
                            Tag="RepoPath"/>
                </Grid>
                <TextBlock Text="Compares the working tree against the current HEAD commit."
                           Margin="0,10,0,0" Foreground="#888" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>

        <!-- "Working tree vs commit" form. -->
        <DataTemplate DataType="{x:Type vm:WorkingTreeVsCommitFormViewModel}">
            <StackPanel>
                <TextBlock Text="Repository path"
                           Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Style="{StaticResource FieldInput}"
                             Text="{Binding RepoPath, UpdateSourceTrigger=PropertyChanged}"
                             Tag="RepoPath"/>
                    <Button Grid.Column="1"
                            Content="Browse…"
                            Margin="6,0,0,0" Padding="10,4"
                            Click="OnBrowseRepoPathClick"
                            Tag="RepoPath"/>
                </Grid>

                <TextBlock Text="Commit-ish (e.g. main, HEAD~3, &lt;sha&gt;)"
                           Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Style="{StaticResource FieldInput}"
                             Text="{Binding CommitIsh, UpdateSourceTrigger=PropertyChanged}"/>
                    <ToggleButton Grid.Column="1"
                                  x:Name="CommitIshPickToggle"
                                  Style="{StaticResource PickToggle}"
                                  IsEnabled="{Binding CommitIshPicker.IsEnabled}"/>
                    <vw:RefPicker Grid.Column="1"
                                  DataContext="{Binding CommitIshPicker}"
                                  IsOpen="{Binding IsChecked, ElementName=CommitIshPickToggle, Mode=TwoWay}"
                                  PlacementTarget="{Binding ElementName=CommitIshPickToggle}"/>
                </Grid>

                <TextBlock Text="Compares the working tree against the given commit."
                           Margin="0,10,0,0" Foreground="#888" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>

        <!-- "Commit vs commit" form. -->
        <DataTemplate DataType="{x:Type vm:CommitVsCommitFormViewModel}">
            <StackPanel>
                <TextBlock Text="Repository path"
                           Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Style="{StaticResource FieldInput}"
                             Text="{Binding RepoPath, UpdateSourceTrigger=PropertyChanged}"
                             Tag="RepoPath"/>
                    <Button Grid.Column="1"
                            Content="Browse…"
                            Margin="6,0,0,0" Padding="10,4"
                            Click="OnBrowseRepoPathClick"
                            Tag="RepoPath"/>
                </Grid>

                <TextBlock Text="Base commit-ish"
                           Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Style="{StaticResource FieldInput}"
                             Text="{Binding BaseCommit, UpdateSourceTrigger=PropertyChanged}"/>
                    <ToggleButton Grid.Column="1"
                                  x:Name="BasePickToggle"
                                  Style="{StaticResource PickToggle}"
                                  IsEnabled="{Binding BaseCommitPicker.IsEnabled}"/>
                    <vw:RefPicker Grid.Column="1"
                                  DataContext="{Binding BaseCommitPicker}"
                                  IsOpen="{Binding IsChecked, ElementName=BasePickToggle, Mode=TwoWay}"
                                  PlacementTarget="{Binding ElementName=BasePickToggle}"/>
                </Grid>

                <TextBlock Text="Compare commit-ish"
                           Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Style="{StaticResource FieldInput}"
                             Text="{Binding CompareCommit, UpdateSourceTrigger=PropertyChanged}"/>
                    <ToggleButton Grid.Column="1"
                                  x:Name="ComparePickToggle"
                                  Style="{StaticResource PickToggle}"
                                  IsEnabled="{Binding CompareCommitPicker.IsEnabled}"/>
                    <vw:RefPicker Grid.Column="1"
                                  DataContext="{Binding CompareCommitPicker}"
                                  IsOpen="{Binding IsChecked, ElementName=ComparePickToggle, Mode=TwoWay}"
                                  PlacementTarget="{Binding ElementName=ComparePickToggle}"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- "Branch vs merge-base" form. One-click setup for the
             dominant PR-style "what did this branch add since it
             forked from main" review workflow. -->
        <DataTemplate DataType="{x:Type vm:BranchVsMergeBaseFormViewModel}">
            <StackPanel>
                <TextBlock Text="Repository path"
                           Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Style="{StaticResource FieldInput}"
                             Text="{Binding RepoPath, UpdateSourceTrigger=PropertyChanged}"
                             Tag="RepoPath"/>
                    <Button Grid.Column="1"
                            Content="Browse…"
                            Margin="6,0,0,0" Padding="10,4"
                            Click="OnBrowseRepoPathClick"
                            Tag="RepoPath"/>
                </Grid>

                <TextBlock Text="Branch (e.g. feature/x)"
                           Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Style="{StaticResource FieldInput}"
                             Text="{Binding Branch, UpdateSourceTrigger=PropertyChanged}"/>
                    <ToggleButton Grid.Column="1"
                                  x:Name="BranchPickToggle"
                                  Style="{StaticResource PickToggle}"
                                  IsEnabled="{Binding BranchPicker.IsEnabled}"/>
                    <vw:RefPicker Grid.Column="1"
                                  DataContext="{Binding BranchPicker}"
                                  IsOpen="{Binding IsChecked, ElementName=BranchPickToggle, Mode=TwoWay}"
                                  PlacementTarget="{Binding ElementName=BranchPickToggle}"/>
                </Grid>

                <TextBlock Text="Merge-base partner (e.g. origin/main, master)"
                           Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Style="{StaticResource FieldInput}"
                             Text="{Binding MergeBasePartner, UpdateSourceTrigger=PropertyChanged}"/>
                    <ToggleButton Grid.Column="1"
                                  x:Name="PartnerPickToggle"
                                  Style="{StaticResource PickToggle}"
                                  IsEnabled="{Binding MergeBasePartnerPicker.IsEnabled}"/>
                    <vw:RefPicker Grid.Column="1"
                                  DataContext="{Binding MergeBasePartnerPicker}"
                                  IsOpen="{Binding IsChecked, ElementName=PartnerPickToggle, Mode=TwoWay}"
                                  PlacementTarget="{Binding ElementName=PartnerPickToggle}"/>
                </Grid>

                <TextBlock Text="Compares the branch tip against the most recent common ancestor it shares with the partner ref. Additions show as right-only — the standard PR-review shape."
                           Margin="0,10,0,0" Foreground="#888" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>

        <!-- "GitHub pull request" form. -->
        <DataTemplate DataType="{x:Type vm:GitHubPullRequestFormViewModel}">
            <StackPanel>
                <TextBlock Text="Pull request URL"
                           Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource FieldInput}"
                         Text="{Binding PullRequestUrl, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Example: https://github.com/owner/repo/pull/123"
                           Margin="0,4,0,0" Foreground="#888" TextWrapping="Wrap"/>
                <TextBlock Text="DiffViewer will look up the merge-base and head SHAs from GitHub. If the repo isn't cloned locally yet, you'll be prompted to browse to it or clone it."
                           Margin="0,10,0,0" Foreground="#888" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>

        <!-- "View stash" form. -->
        <DataTemplate DataType="{x:Type vm:ViewStashFormViewModel}">
            <StackPanel>
                <TextBlock Text="Repository path"
                           Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Style="{StaticResource FieldInput}"
                             Text="{Binding RepoPath, UpdateSourceTrigger=PropertyChanged}"
                             Tag="RepoPath"/>
                    <Button Grid.Column="1"
                            Content="Browse…"
                            Margin="6,0,0,0" Padding="10,4"
                            Click="OnBrowseRepoPathClick"
                            Tag="RepoPath"/>
                </Grid>

                <TextBlock Text="Select a stash"
                           Style="{StaticResource FieldLabel}"/>

                <!-- Loading indicator. -->
                <TextBlock Text="Loading stashes…"
                           Foreground="#888" FontStyle="Italic"
                           Margin="0,4,0,0"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

                <!-- Inline stash list (no popup — this mode is
                     dedicated to picking a stash, so the list
                     IS the primary control). -->
                <ListBox ItemsSource="{Binding Stashes}"
                         SelectedItem="{Binding SelectedStash, Mode=TwoWay}"
                         MaxHeight="180"
                         Margin="0,4,0,0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2,3">
                                <TextBlock Text="{Binding SymbolicName}"
                                           FontFamily="Consolas"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Subject}"
                                           Foreground="#555" Margin="8,0,0,0"
                                           MaxWidth="260" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TipShortSha, StringFormat=' · {0}'}"
                                           Foreground="#888" Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="Compares the stash's working-tree snapshot against HEAD at the time the stash was created."
                           Margin="0,10,0,0" Foreground="#888" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="14">

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="0,1,0,0"
                Padding="0,10,0,0" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding CurrentForm.ValidationError}"
                           Foreground="DarkRed"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="OK"
                            Margin="0,0,8,0" Padding="16,4"
                            IsDefault="True"
                            Command="{Binding OkCommand}"/>
                    <Button Content="Cancel"
                            Padding="16,4"
                            IsCancel="True"
                            Command="{Binding CancelCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Left rail: mode picker. -->
        <Border DockPanel.Dock="Left" Width="200" Margin="0,0,12,0"
                BorderBrush="#DDD" BorderThickness="0,0,1,0" Padding="0,0,12,0">
            <ListBox ItemsSource="{Binding Providers}"
                     SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" Padding="4,6"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Right pane: per-mode form (implicit DataTemplate match). -->
        <ContentControl Content="{Binding CurrentForm}"/>
    </DockPanel>
</Window>
