<UserControl x:Class="DiffViewer.Views.DiffToolbarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DiffViewer.ViewModels"
             xmlns:models="clr-namespace:DiffViewer.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:DiffPaneViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Shared chrome palette for the toolbar's three button styles
             (ToggleButton, plain Button, toolbar-style RadioButton). Trigger
             order matters: WPF applies later triggers on top of earlier ones
             for the same property. To make "checked + hovered" and
             "checked + pressed" visibly distinct from plain "checked", they
             are encoded as MultiTriggers that come *after* the bare IsChecked
             trigger so they win when both conditions hold. -->

        <Style x:Key="ToolbarToggleStyle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EAEAEA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D0D0D0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D0E7FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#B3D7FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsPressed" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#9CC3F0"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EAEAEA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D0D0D0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toolbar-style RadioButton: looks like the other toolbar toggle
             buttons (square border, no radio dot) but inherits RadioButton's
             "click-to-check, never click-to-uncheck" behavior — exactly what
             the side-visibility group needs. Mutual exclusion is driven by
             the bindings (all three IsChecked properties target the same
             enum source via EnumToBoolConverter), not GroupName. -->
        <Style x:Key="ToolbarRadioStyle" TargetType="RadioButton">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EAEAEA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D0D0D0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D0E7FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#B3D7FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsPressed" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#9CC3F0"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#F8F8F8"
            BorderBrush="#DDD"
            BorderThickness="0,0,0,1"
            Padding="6,4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <!-- Text-diff toggles and side-visibility group. Collapsed
                     for image files (no notion of whitespace, intra-line,
                     wrap, etc.). All bindings target DiffPaneViewModel. -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding ShowImageDiff, Converter={x:Static vm:FalseToVisibleConverter.Instance}}">
                    <ToggleButton Style="{StaticResource ToolbarToggleStyle}"
                                  IsChecked="{Binding IgnoreWhitespace}"
                                  Content="Ignore WS"
                                  ToolTip="Ignore whitespace differences (Ctrl+W)"/>
                    <ToggleButton Style="{StaticResource ToolbarToggleStyle}"
                                  IsChecked="{Binding ShowIntraLineDiff}"
                                  Content="Intra-line"
                                  ToolTip="Show word-level highlights inside modified lines (Ctrl+D)"/>
                    <ToggleButton Style="{StaticResource ToolbarToggleStyle}"
                                  IsChecked="{Binding IsSideBySide}"
                                  Content="Side-by-side"
                                  ToolTip="Toggle between side-by-side and inline diff layout (Ctrl+I)"/>
                    <ToggleButton Style="{StaticResource ToolbarToggleStyle}"
                                  IsChecked="{Binding ShowVisibleWhitespace}"
                                  Content="Show WS"
                                  ToolTip="Render spaces, tabs, and end-of-line markers (Ctrl+Shift+W)"/>
                    <ToggleButton Style="{StaticResource ToolbarToggleStyle}"
                                  IsChecked="{Binding ShowLineNumbers}"
                                  Content="Line #s"
                                  ToolTip="Show line numbers in the editor gutters"/>
                    <ToggleButton Style="{StaticResource ToolbarToggleStyle}"
                                  IsChecked="{Binding WordWrap}"
                                  Content="Wrap"
                                  ToolTip="Wrap long lines at the editor's right edge (Ctrl+Shift+L)"/>

                    <Separator Margin="6,2" Width="1" Background="#CCC"/>

                    <!-- Side-visibility radio group: RadioButton.OnToggle only
                         ever sets IsChecked = true, so clicking the active one
                         is a true no-op (the user can't end up with all three
                         off). Mutual exclusion is driven by the shared source
                         property — when one click flips the enum, the other
                         two bindings re-evaluate Convert and uncheck themselves.
                         The group is greyed in inline mode since it only
                         affects the side-by-side layout. -->
                    <RadioButton Style="{StaticResource ToolbarRadioStyle}"
                                 IsChecked="{Binding SideVisibility, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter={x:Static models:DiffSideVisibility.LeftOnly}}"
                                 Content="Left"
                                 ToolTip="Show only the left (old) side"/>
                    <RadioButton Style="{StaticResource ToolbarRadioStyle}"
                                 IsChecked="{Binding SideVisibility, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter={x:Static models:DiffSideVisibility.Both}}"
                                 Content="Both"
                                 ToolTip="Show both sides"/>
                    <RadioButton Style="{StaticResource ToolbarRadioStyle}"
                                 IsChecked="{Binding SideVisibility, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter={x:Static models:DiffSideVisibility.RightOnly}}"
                                 Content="Right"
                                 ToolTip="Show only the right (new) side"/>

                    <Separator Margin="6,2" Width="1" Background="#CCC"/>
                </StackPanel>

                <!-- Image-mode radio group: visible only when an image is
                     dispatched. RadioButtons bind to ImageDiff.Mode via the
                     shared EnumToBoolConverter pattern. -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding ShowImageDiff, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <RadioButton Style="{StaticResource ToolbarRadioStyle}"
                                 IsChecked="{Binding ImageDiff.Mode, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter={x:Static models:ImageDiffMode.SideBySide}}"
                                 Content="Side-by-side"
                                 ToolTip="Show both images in adjacent panes"/>
                    <RadioButton Style="{StaticResource ToolbarRadioStyle}"
                                 IsChecked="{Binding ImageDiff.Mode, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter={x:Static models:ImageDiffMode.Swipe}}"
                                 Content="Swipe"
                                 ToolTip="Overlay both images with a draggable divider"/>
                    <RadioButton Style="{StaticResource ToolbarRadioStyle}"
                                 IsChecked="{Binding ImageDiff.Mode, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter={x:Static models:ImageDiffMode.OnionSkin}}"
                                 Content="Onion-skin"
                                 ToolTip="Stack both images with an opacity slider to blend between them"/>

                    <Separator Margin="6,2" Width="1" Background="#CCC"/>
                </StackPanel>

                <!-- Bound to the MainViewModel commands (same ones F7/F8 fire)
                     so toolbar clicks and keyboard shortcuts share one
                     code path: step within file, then cross file/section
                     boundaries, skipping whitespace-only files. -->
                <Button Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding DataContext.NavigatePreviousChangeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Content="Prev"
                        ToolTip="Previous change (F7)"/>
                <Button Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding DataContext.NavigateNextChangeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Content="Next"
                        ToolTip="Next change (F8)"/>

                <Separator Margin="6,2" Width="1" Background="#CCC"/>

                <ToggleButton Style="{StaticResource ToolbarToggleStyle}"
                              IsChecked="{Binding LiveUpdates}"
                              IsEnabled="{Binding IsLiveUpdatesAvailable}"
                              Content="Live"
                              ToolTip="Auto-refresh when the working tree changes (Ctrl+L; greyed for commit-vs-commit)"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding DataContext.ShowKeyboardShortcutsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="Keyboard shortcuts (F1)">
                    <Grid Width="18" Height="14">
                        <TextBlock Text="&#xE765;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="?"
                                   FontFamily="Segoe UI"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="#0078D4"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,-2,-3"/>
                    </Grid>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding DataContext.ShowSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Content="&#xE713;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        ToolTip="Settings (Ctrl+,)"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
