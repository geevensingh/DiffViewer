<UserControl x:Class="DiffViewer.Views.RecentsBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DiffViewer.ViewModels"
             xmlns:vw="clr-namespace:DiffViewer.Views"
             d:DataContext="{d:DesignInstance Type=vm:RecentContextsViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Padding="6,4"
            Background="#F5F5F5"
            BorderBrush="#DDDDDD"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding ItemViews}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding IsEnabled}"
                      AutomationProperties.Name="Recent contexts"
                      ToolTipService.ShowOnDisabled="True">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RecentContextItem}">
                        <StackPanel Orientation="Vertical"
                                    ToolTip="{Binding Tooltip}"
                                    AutomationProperties.Name="{Binding AccessibilityName}">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Subtitle}"
                                       FontSize="10"
                                       Foreground="#888888"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Worktree switcher: re-opens the same comparison rooted
                 at another worktree of the same repository. Hidden when
                 no enumerator/switcher is wired (cold-launch empty
                 state, tests). -->
            <ToggleButton x:Name="WorktreeToggle"
                          Grid.Column="1"
                          Margin="6,0,0,0"
                          Padding="10,2"
                          MinWidth="80"
                          Content="Worktree"
                          IsEnabled="{Binding IsEnabled}"
                          Visibility="{Binding IsWorktreeSwitchEnabled, Converter={StaticResource BoolToVis}}"
                          AutomationProperties.Name="Switch worktree"
                          ToolTip="Show this same diff in another worktree of this repository"/>
            <vw:WorktreePicker Grid.Column="1"
                               DataContext="{Binding WorktreePicker}"
                               IsOpen="{Binding IsChecked, ElementName=WorktreeToggle, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=WorktreeToggle}"/>

            <!-- "+ New diff" opens the mode-picker dialog (commit vs
                 commit, working tree vs HEAD/commit, GitHub PR, etc.).
                 Hidden when no dialog host or switcher is wired (tests,
                 degenerate startup paths) so we never present a
                 non-functional button. -->
            <Button Grid.Column="2"
                    Margin="6,0,0,0"
                    Padding="10,2"
                    MinWidth="90"
                    Content="+ New diff"
                    Command="{Binding NewDiffCommand}"
                    Visibility="{Binding IsNewDiffEnabled, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.Name="New diff"
                    ToolTip="Start a new diff without restarting the app"/>
        </Grid>
    </Border>
</UserControl>
