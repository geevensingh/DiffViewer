<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DiffViewer</RootNamespace>
    <AssemblyName>DiffViewer</AssemblyName>
    <ApplicationIcon>Assets\diffviewer.ico</ApplicationIcon>
    <!-- PHASE 1 SPIKE: WPF's auto-generated Main doesn't let Velopack
         intercept its install/update/restart args before WPF spins up.
         We replace it with our own static Main in App.xaml.cs per the
         Velopack WPF sample. -->
    <StartupObject>DiffViewer.App</StartupObject>
    <!-- DiffViewer's own strings are hard-coded English; no .resx, no
         x:Uid. The 11 framework locale folders shipped by the .NET
         desktop runtime (cs/de/es/fr/it/ja/ko/pl/pt-BR/ru/tr) only
         localize system chrome (MessageBox buttons, AvalonEdit's Find
         panel, etc.) so stripping them keeps the publish output small
         without affecting our UI. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also include as a Resource so MainWindow.xaml's Icon="" pack URI
         can load the same file at runtime (Window.Icon doesn't auto-pick
         up <ApplicationIcon>). -->
    <Resource Include="Assets\diffviewer.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hand-authored AvalonEdit syntax-highlighting definitions (TypeScript,
         YAML, Go, Rust, Ruby, Bash, TOML). Registered at app startup via
         CustomHighlightingRegistrar; the wildcard keeps the csproj in sync
         as new definitions are added or removed. -->
    <EmbeddedResource Include="Resources\Highlighting\*.xshd" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- PHASE 1 SPIKE: Velopack does its own extraction at install
         time, which is mutually exclusive with PublishSingleFile. Keep
         self-contained win-x64 but let the publish output be a regular
         folder layout that vpk pack will wrap into its installer. -->
    <!--<PublishSingleFile>true</PublishSingleFile>-->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!--<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>-->
  </PropertyGroup>

  <ItemGroup>
    <!-- PHASE 1 SPIKE: re-declare App.xaml from ApplicationDefinition
         to Page so WPF stops auto-generating a Main entry point. Our
         own Main lives in App.xaml.cs and runs VelopackApp.Build().Run()
         before WPF spins up. Per the Velopack WPF sample csproj. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DiffViewer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <PackageReference Include="DiffPlex" Version="1.7.2" />
    <PackageReference Include="LibGit2Sharp" Version="0.31.0" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <PackageReference Include="Velopack" Version="1.1.1" />
  </ItemGroup>

</Project>
